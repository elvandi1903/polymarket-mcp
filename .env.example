# Template only — do NOT put values here. Copy to .env and fill on YOUR machine.
# NEVER commit a filled .env or .env.example.
POLY_PRIVATE_KEY=
POLY_WALLET=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_BUILDER_CODE=
# Optional: relayer key for gasless transactions (setup_trading_approvals).
# Create at polymarket.com -> Settings -> API Keys -> Relayer API Keys.
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
POLY_ALLOW_LIVE=0
POLY_MAX_NOTIONAL=
POLY_MAX_OPEN_ORDERS=
POLY_NONCE=0
# HTTP transport security. Set a long random token to protect your MCP HTTP
# server when exposed outside loopback. Clients send it as Authorization: Bearer <token>.
POLY_HTTP_TOKEN=
